# Green Continent Tours — Apache config (one.com compatible)
# Generated by scripts/prerender.py — edit scripts/htaccess.template, not this file.
# Rewrites use mod_rewrite only; cache rules are wrapped in IfModule so they are skipped if unavailable

Options -MultiViews
RewriteEngine On

# 1. Force HTTPS (covers http://example.com and http://www.example.com)
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://www.greencontinenttours.com/$1 [R=301,L]

# 2. Force www (covers https://example.com -> https://www.example.com)
RewriteCond %{HTTP_HOST} ^greencontinenttours\.com$ [NC]
RewriteRule ^(.*)$ https://www.greencontinenttours.com/$1 [R=301,L]

# 3. Legacy URLs and duplicate homepage
RewriteRule ^home/?$ / [NC,R=301,L]
RewriteRule ^contact-us/?$ /contact [NC,R=301,L]
RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
RewriteRule ^ / [R=301,L]

# 4. Strip .html extensions (e.g. /contact.html -> /contact)
RewriteCond %{THE_REQUEST} \s/([^?\s]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# 5. Lowercase + no trailing slash for every page (e.g. /About/ -> /about)
{{CANONICAL_RULES}}

# 6. Serve the pre-rendered page for each URL
{{PRERENDER_RULES}}

# 7. Anything else that is not a real file -> "page not found" page
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ 404.html [L]

# 8. Browser caching (skipped automatically if mod_expires is not available)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
